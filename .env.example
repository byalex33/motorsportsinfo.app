# Neon Postgres (provisioned through the Vercel Marketplace). Leave unset locally to read sources live without a database.
DATABASE_URL=
# Protects /api/cron/* — Vercel sends it as a Bearer token.
CRON_SECRET=
# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@motorsportsinfo.app
# Optional: the push endpoint of the owner's own device (turn on push at /alerts, then copy the endpoint from its
# push_subscriptions row, or from DevTools: (await (await navigator.serviceWorker.ready).pushManager.getSubscription()).endpoint).
# At 07:00 UTC each day the alerts cron pushes it once if the schedule sync is unhealthy (as GET /api/status would
# answer 503). Unset: no owner alert.
OWNER_PUSH_ENDPOINT=
# Rainbow.ai Tiles API key for the forecast rain radar (developer.rainbow.ai). Unset: the radar shows RainViewer's past 2 hours.
RAINBOW_API_KEY=
# Forecast tiles fetched per month before the radar falls back to the past radar. Default 30000 (Rainbow's free tier).
RAINBOW_MONTHLY_TILE_CAP=
# IMSA's calendar feed: the iCal link from imsa.com's "Add to Calendar" (ECAL), subscribed to the WeatherTech
# SportsCar Championship only. Unset: the IMSA page shows "Schedule coming soon".
IMSA_CALENDAR_URL=
